# Large binary firmware dumps and images (>100MB limit on GitHub)
*.img
*.raw
*.bin
*.dump
*.tar
*.gz
*.zip
*.7z
*.rar

# Android APKs and extracted builds
*.apk
*.idsig
*.dex
*.jar

# Backups and temporary dumps
backup_*
extracted_*
*_decoded
*_dump
*_decompiled
scratchextracted/
temp_*
scratch/
PhoenixSuit/
jadx/

# Python cache & logs
__pycache__/
*.pyc
*.log

# Sensitive keys and signatures
*.key
*.p12
*.pk8
*.pem
*.rsa

# Loose images in root (keep assets)
/*.png
/*.jpg
/*.JPG
/*.html
/*.txt
/*.xml
/*.bat
/*.sh
/*.py
/*.db
/*.so
/*.deb
/*.ko
/*.dtb
!/assets/
!/assets/*
!/README.md
!/.gitignore
!/prhub.apk
